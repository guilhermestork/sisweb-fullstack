            "body": {
              "mode": "raw",
              "raw": "{\n  \"numero\": \"\",\n  \"vara\": \"\",\n  \"comarca\": \"Florianópolis\",\n  \"clienteId\": \"um\",\n  \"status\": \"pausado\"\n}",
              "options": {

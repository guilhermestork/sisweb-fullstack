              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Outra Maria\",\n  \"cpf\": \"12345678909\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/clientes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clientes"
              ]
            }
          }
        },
        {
          "name": "Listar clientes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/clientes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clientes"
              ]
            }
          }
        },
        {
          "name": "Buscar cliente 1 (com processos)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/clientes/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clientes",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
